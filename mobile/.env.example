# Firebase (FCM) — from Firebase Console → Project settings → Your apps
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_IOS_BUNDLE_ID=com.nvnhan0810.flc
